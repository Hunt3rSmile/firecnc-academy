pkgname=firecnc-academy
pkgver=0.4.1
pkgrel=1
pkgdesc='Offline CNC learning with turning, milling simulation, and signed licenses'
arch=('x86_64')
license=('MIT' 'OFL-1.1' 'LicenseRef-Electron-ThirdParty')
depends=('glibc' 'gcc-libs' 'glib2' 'nss' 'nspr' 'gtk3' 'alsa-lib' 'libsecret' 'gnome-keyring'
         'at-spi2-core' 'libcups' 'dbus' 'cairo' 'pango' 'libx11'
         'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxrandr'
         'libxcb' 'libxkbcommon' 'mesa' 'expat' 'systemd-libs'
         'hicolor-icon-theme')
options=('!strip' '!debug')
source=()
sha256sums=()

prepare() {
  if [[ ! -x "$startdir/../release/linux-unpacked/firecnc-academy" ]]; then
    error 'Build the Linux runtime first: npm ci && npm run pack:linux'
    return 1
  fi
}

package() {
  local project_dir="$startdir/.."
  install -dm755 "$pkgdir/opt/firecnc-academy"
  cp -a "$project_dir/release/linux-unpacked/." "$pkgdir/opt/firecnc-academy/"
  # The bundled helper stays sandboxed when user namespaces are unavailable.
  chmod 4755 "$pkgdir/opt/firecnc-academy/chrome-sandbox"
  install -Dm755 "$startdir/firecnc-academy" "$pkgdir/usr/bin/firecnc-academy"
  install -Dm644 "$startdir/firecnc-academy.desktop" "$pkgdir/usr/share/applications/firecnc-academy.desktop"
  install -Dm644 "$startdir/firecnc-academy.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/firecnc-academy.svg"
  install -Dm644 "$project_dir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$project_dir/third-party/NotoSans-LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/OFL-fonts.txt"
  install -Dm644 "$project_dir/release/linux-unpacked/THIRD_PARTY_NOTICES.txt" "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.txt"
  install -Dm644 "$project_dir/release/linux-unpacked/LICENSES.chromium.html" "$pkgdir/usr/share/licenses/$pkgname/LICENSES.chromium.html"
}
